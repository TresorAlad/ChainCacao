{
  "name": "chaincacao",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "jest",
    "eas:login": "npx --yes eas-cli@latest login",
    "eas:init": "npx --yes eas-cli@latest init",
    "eas:env:google-production": "npx --yes eas-cli@latest env:create --environment production --name GOOGLE_SERVICES_JSON --type file --value ./google-services.json --visibility secret",
    "eas:env:google-preview": "npx --yes eas-cli@latest env:create --environment preview --name GOOGLE_SERVICES_JSON --type file --value ./google-services.json --visibility secret",
    "eas:build:apk": "npx --yes eas-cli@latest build --platform android --profile preview",
    "eas:build:production-apk": "npx --yes eas-cli@latest build --platform android --profile production-apk",
    "eas:build:aab": "npx --yes eas-cli@latest build --platform android --profile production",
    "eas:update:preview": "npx --yes eas-cli@latest update --channel preview --platform android --environment production --non-interactive",
    "eas:update:production": "npx --yes eas-cli@latest update --channel production --platform android --environment production --non-interactive"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.6.0",
    "@react-native-community/netinfo": "11.5.2",
    "@react-native-picker/picker": "2.11.4",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@types/react": "~19.2.10",
    "axios": "^1.15.2",
    "eslint-config-expo": "~55.0.1",
    "expo": "^55.0.24",
    "expo-camera": "~55.0.18",
    "expo-constants": "~55.0.16",
    "expo-device": "~55.0.17",
    "expo-file-system": "~55.0.20",
    "expo-font": "~55.0.7",
    "expo-haptics": "~55.0.14",
    "expo-image": "~55.0.10",
    "expo-linear-gradient": "~55.0.14",
    "expo-linking": "~55.0.15",
    "expo-local-authentication": "~55.0.14",
    "expo-location": "~55.1.10",
    "expo-network": "~55.0.14",
    "expo-notifications": "~55.0.23",
    "expo-router": "~55.0.14",
    "expo-splash-screen": "~55.0.21",
    "expo-status-bar": "~55.0.6",
    "expo-symbols": "~55.0.8",
    "expo-system-ui": "~55.0.18",
    "expo-updates": "~55.0.22",
    "expo-web-browser": "~55.0.16",
    "jest-expo": "~55.0.17",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-chart-kit": "^6.12.0",
    "react-native-confirmation-code-field": "^9.0.0",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.7.4"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.10",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~55.0.1",
    "jest": "~29.7.0",
    "jest-expo": "~55.0.17",
    "typescript": "~5.9.2"
  },
  "private": true
}
