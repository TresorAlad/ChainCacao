# URL de l'API (sans /api/v1 — les routes l'ajoutent déjà).
# IMPORTANT : figée au moment du build EAS ; une OTA ne change pas cette URL.
# cp .env.example .env

# Production (même serveur que le site web cacaombh.vercel.app)
# EXPO_PUBLIC_API_URL=http://13.60.214.56:8080

# Émulateur Android
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8080

# Téléphone sur le même Wi-Fi (IP du PC)
# EXPO_PUBLIC_API_URL=http://192.168.1.25:8080
