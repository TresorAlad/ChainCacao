PORT=8080
JWT_SECRET=replace-with-strong-secret

# --- Docker Compose (tracabilite-api/docker-compose.yml) ---
# Depuis le conteneur api, l’hôte Postgres est le nom du service : postgres (pas 127.0.0.1).
# DATABASE_URL=postgres://chaincacao:chaincacao@postgres:5432/chaincacao
# Redis sur le réseau compose : REDIS_URL=redis://redis:6379/0
# Portefeuille démo exportateur / transformateur (avec actor_wallets + migrations) :
# DEMO_INITIAL_CREDIT=true
# DEMO_INITIAL_CREDIT_AMOUNT=2000000
# Fabric depuis Docker : extra_hosts peer0.org1.example.com + volumes crypto sous /fabric-crypto
# (voir commentaires FABRIC_* ci-dessous ; USE_INMEMORY_FABRIC=true si pas de peer).
# En production : JWT_SECRET fort (>= 32 caractères), APP_ENV=production.
# Durée session JWT en heures (défaut 720 = 30 jours, mobile reste connecté)
# JWT_DURATION_HOURS=720
ALLOWED_ORIGINS=http://localhost:3000

# PostgreSQL local ou Neon (ne jamais committer de vrais identifiants)
# Utiliser l'URL "pooler" Neon en prod ; le simple protocol est activé par défaut (login/signup).
# DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Pool pgx (optionnel)
# PG_MAX_CONNS=25
# PG_MIN_CONNS=5
# PG_SIMPLE_PROTOCOL=false  # désactiver seulement si Postgres direct sans pooler

# APP_ENV=production
# Timeouts HTTP (secondes). Défauts serveur : read/write 300s (upload photo mobile lent), idle 180s.
# Réduire seulement derrière un proxy qui gère déjà les corps volumineux.
# HTTP_READ_TIMEOUT_SEC=300
# HTTP_WRITE_TIMEOUT_SEC=300
# HTTP_IDLE_TIMEOUT_SEC=180

# Redis (rate limit /verify)
# REDIS_URL=redis://localhost:6379/0

# Ledger : laisser vide ou true pour demo sans peer Fabric
USE_INMEMORY_FABRIC=true

# Portefeuille démo exportateur / transformateur (migration 012 actor_wallets ; DATABASE_URL pour persistance PG)
# DEMO_INITIAL_CREDIT=false
# DEMO_INITIAL_CREDIT_AMOUNT=2000000

# QR / liens publics
PUBLIC_VERIFY_BASE_URL=https://chaincacao.tg/verify

# Cloudinary (upload photo lot)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=

# Firebase FCM (compte de service — fichier JSON téléchargé depuis la console Firebase)
# Docker : fichier monté dans le conteneur sous /secrets/
# FIREBASE_CREDENTIALS_FILE=/secrets/firebase-adminsdk.json
# ou tout le JSON sur une ligne :
# FIREBASE_CREDENTIALS_JSON={"type":"service_account",...}

# PDF EUDR : cle RSA PEM (PKCS1 ou PKCS8), optionnel
# EUDR_RSA_PRIVATE_KEY_PEM="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# --- Hyperledger Fabric Gateway (si USE_INMEMORY_FABRIC=false) ---
# Ne JAMAIS laisser un placeholder dans FABRIC_KEY_PATH : soit un chemin réel de fichier,
# soit mieux : utilisez *_DIR (l’API lit le premier fichier du dossier — standard test-network).
#
# Avec docker-compose.yml (volume organizations -> /fabric-crypto) :
# USE_INMEMORY_FABRIC=false
# FABRIC_MSP_ID=Org1MSP
# FABRIC_PEER_ENDPOINT=dns:///peer0.org1.example.com:7051
# FABRIC_GATEWAY_PEER=peer0.org1.example.com
# FABRIC_TLS_CERT_PATH=/fabric-crypto/peerOrganizations/org1.example.com/peers/peer0.org1.example.com/tls/ca.crt
# FABRIC_SIGNCERT_DIR=/fabric-crypto/peerOrganizations/org1.example.com/users/User1@org1.example.com/msp/signcerts
# FABRIC_KEYSTORE_DIR=/fabric-crypto/peerOrganizations/org1.example.com/users/User1@org1.example.com/msp/keystore
# (Ne pas définir FABRIC_SIGNCERT_PATH / FABRIC_KEY_PATH si vous utilisez *_DIR.)
#
# Équivalent avec fichiers explicites (nom du fichier keystore variable selon la génération réseau) :
# FABRIC_SIGNCERT_PATH=/fabric-crypto/.../msp/signcerts/cert.pem
# FABRIC_KEY_PATH=/fabric-crypto/.../msp/keystore/<nom_du_fichier_sk>
#
# Sans Docker sur la machine : chemins absolus vers fabric-samples/test-network/organizations/...
#
# Sans peer Fabric : USE_INMEMORY_FABRIC=true (ledger mémoire).
# FABRIC_CHANNEL=chaincacao-channel
# FABRIC_CHAINCODE=chaincacao
#
# Alternative si le peer n’est pas joignable en direct depuis l’API : proxy HTTP interne
# FABRIC_PROXY_URL=https://fabric-proxy.example.internal
# FABRIC_PROXY_TOKEN=
